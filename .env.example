# Copy to .env and replace every placeholder value before docker compose up.
# JWT_SECRET must be at least 32 bytes: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-bytes-random-string
POSTGRES_DB=barezen
POSTGRES_USER=barezen
POSTGRES_PASSWORD=replace-with-a-strong-password
SERVER_PORT=8080

# Object storage (optional). Leave STORAGE_BACKEND=local to keep blobs on the
# STORAGE_DIR volume. Set s3 to store content in any S3-compatible bucket
# (MinIO, Cloudflare R2, Tencent COS, ...). STORAGE_DIR is still required:
# upload chunks are staged there before merge, and the s3 backend spools
# oversized single-part bodies through it.
# S3_ENDPOINT must be the scheme+host only (https://minio.example.com:9000);
# do not append the bucket name. Self-hosted gateways usually need path-style
# addressing, so set S3_PATH_STYLE=true together with S3_ENDPOINT.
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=false

# Rate limiting keys on the socket peer unless this is true. Set it only when the
# container sits behind a reverse proxy that rewrites X-Forwarded-For (nginx,
# Caddy, ...); then the right-most entry in that header is taken as the client.
TRUST_PROXY=false
